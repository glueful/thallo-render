{% extends 'layout.twig' %}
{% block content %}
  {% if entry is defined and entry %}
    <article>
      {% if presentation.show_title ?? true %}
        <div class="entry-content"><h1>{{ entry.fields.title }}</h1></div>
      {% endif %}
      {# Byte-mirror of entry.twig's body branch (spec pin): a homepage with a
         blocks body renders blocks(), never the scalar fallback. #}
      {% if entry.fields.body is defined %}
        {% if entry.fields.body is iterable %}{{ blocks(entry.fields.body) }}
        {% else %}<div class="entry-content"><div class="body">{{ entry.fields.body }}</div></div>{% endif %}
      {% endif %}
    </article>
  {% else %}
    <div class="entry-content">
      <h1>{{ site.name }}</h1>
      <p>This site is powered by Thallo. Create a theme in themes/ to make it yours.</p>
    </div>
  {% endif %}
{% endblock %}
