{# tabs — maps to refs.md `tabs` (pill variant, size md). CSS-only radio tabs:
   the __radio / __list / __label / __panels / __panel structural classes are
   behaviour hooks the theme CSS selects (checked-sibling → active label + shown
   panel) — keep them, plus the per-instance name="tabs-{id}" / id="tabs-{id}-N"
   scoping so multiple tab blocks on a page stay independent. Fields:
   items — each a block with item.data.label; panel body renders the item itself. #}
<div class="thallo-block thallo-block-tabs">
  {% for item in data.items|default([]) %}
  <input class="thallo-block-tabs__radio" type="radio" name="tabs-{{ block.id }}" id="tabs-{{ block.id }}-{{ loop.index }}"{% if loop.first %} checked{% endif %}>
  {% endfor %}
  <div class="thallo-block-tabs__list" role="tablist">
    {% for item in data.items|default([]) %}
    <label class="thallo-block-tabs__label" for="tabs-{{ block.id }}-{{ loop.index }}">{{ item.data.label|default('') }}</label>
    {% endfor %}
  </div>
  <div class="thallo-block-tabs__panels">
    {% for item in data.items|default([]) %}
    <div class="thallo-block-tabs__panel">{{ blocks([item]) }}</div>
    {% endfor %}
  </div>
</div>
