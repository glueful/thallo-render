{# footer — a <footer> bar (refs.md `footer`). An optional top band
   (drop a columns block with links here), then a container row with three slots:
   left = copyright, center = links, right = social. On narrow screens the row
   stacks and centers; on wide it spreads left/center/right. Authored in the theme's
   BEM/computed-class convention (see navigation.twig / separator.twig).
   Fields (all blocks): top, copyright (holds a shortcode/rich_text/logo), links,
   social. #}
{% set hasTop = data.top|default([]) is not empty %}
{% set hasLeft = data.copyright|default([]) is not empty %}
{% set hasCenter = data.links|default([]) is not empty %}
{% set hasRight = data.social|default([]) is not empty %}
<footer class="thallo-block thallo-block-footer{{ style_classes('root') }}"{{ style_attrs('root') }}>
  {% if hasTop or is_canvas() %}<div class="thallo-block-footer__top"{{ slot_attrs('top') }}>{{ blocks(data.top|default([])) }}</div>{% endif %}
  <div class="thallo-block-footer__bar">
    {% if hasLeft or is_canvas() %}<div class="thallo-block-footer__left"{{ slot_attrs('copyright') }}>{{ blocks(data.copyright|default([])) }}</div>{% endif %}
    {% if hasCenter or is_canvas() %}<div class="thallo-block-footer__center"{{ slot_attrs('links') }}>{{ blocks(data.links|default([])) }}</div>{% endif %}
    {% if hasRight or is_canvas() %}<div class="thallo-block-footer__right"{{ slot_attrs('social') }}>{{ blocks(data.social|default([])) }}</div>{% endif %}
  </div>
</footer>
