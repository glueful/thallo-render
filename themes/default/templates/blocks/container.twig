{# container — a layout wrapper with a background image or video and an overlay. Authored in the
   theme's BEM/computed-class convention: the background and overlay presets are guarded
   `--modifier` classes.

   Layout is SETTINGS, not data (container-layout spec §4): the band's own box, minimum height and
   overflow land on `root`; how the children are arranged — display, direction, wrap, tracks, gaps,
   alignment, content width and gutter — lands on `inner`. Nothing here is inline, and no modifier
   class describes layout any more.

   A background_image renders as a positioned <img> layer with srcset under the priority-image
   contract (claim_priority_image()); a background_video (blob) or background_video_url renders a
   muted looping layer behind the overlay: a blob/direct file URL as <video>, a YouTube/Vimeo URL
   as a cover iframe (id parsed by video_embed, so the raw URL never reaches src). The video wins
   over the image if both are set. #}
{% set img = data.background_image ? media_image(data.background_image, [960, 1280, 1920]) : null %}
{# Background video precedence: uploaded blob > URL. A URL is either a YouTube/Vimeo
   embed (rendered as a cover iframe, id parsed by video_embed so the raw URL never
   reaches src) or a direct video-file URL (native <video>, scheme-allowlisted). #}
{% set vid = data.background_video ? media(data.background_video) : null %}
{% set vidUrl = (data.background_video_url|default(''))|trim %}
{% set vidEmbed = (not vid and vidUrl) ? video_embed(vidUrl) : null %}
{% set videoSrc = vid ?? ((not vidEmbed and vidUrl) ? (vidUrl|safe_url) : null) %}

{# The root's tag is structure the author chooses, through an allowlist: an unknown or missing
   value is a div, so a stored value can never reach the markup unchecked. #}
{% set tag = {
  div: 'div', section: 'section', article: 'article',
  aside: 'aside', header: 'header', footer: 'footer',
}[data.element|default('div')] ?? 'div' %}
{% set overlay = {light: 'light', dark: 'dark'}[data.overlay|default('none')] ?? '' %}
{% set overlayMods = overlay ? ([
  'thallo-block-container--overlay-' ~ overlay,
  'thallo-block-container--overlay-' ~ ({'25': '25', '50': '50', '75': '75'}[data.overlay_opacity|default('50')] ?? '50'),
]|join(' ')) : '' %}

{% set rootClass = ['thallo-block thallo-block-container', overlayMods]|join(' ')|trim %}
{% set bgClass = [
  'thallo-block-container__bg',
  'thallo-block-container__bg--' ~ ({cover: 'cover', contain: 'contain', auto: 'auto'}[data.bg_size|default('cover')] ?? 'cover'),
  'thallo-block-container__bg--pos-' ~ ({center: 'center', top: 'top', bottom: 'bottom', left: 'left', right: 'right'}[data.bg_position|default('center')] ?? 'center'),
]|join(' ') %}

<{{ tag }} class="{{ rootClass }}{{ style_classes('root') }}"{{ style_attrs('root') }}>
  {% if videoSrc %}<video class="thallo-block-container__video" src="{{ videoSrc }}" autoplay muted loop playsinline></video>
  {% elseif vidEmbed %}<div class="thallo-block-container__video-cover">
    {%- if vidEmbed.provider == 'youtube' -%}
      <iframe class="thallo-block-container__video-frame" src="https://www.youtube-nocookie.com/embed/{{ vidEmbed.id }}?autoplay=1&mute=1&loop=1&playlist={{ vidEmbed.id }}&controls=0&modestbranding=1&playsinline=1&showinfo=0&rel=0" title="" loading="lazy" allow="autoplay" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    {%- elseif vidEmbed.provider == 'vimeo' -%}
      <iframe class="thallo-block-container__video-frame" src="https://player.vimeo.com/video/{{ vidEmbed.id }}?autoplay=1&muted=1&loop=1&background=1" title="" loading="lazy" allow="autoplay" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    {%- endif -%}
  </div>
  {% elseif img %}
    {% set priority = claim_priority_image() %}
    <img class="{{ bgClass }}" src="{{ img.src }}"
         {%- if img.srcset %} srcset="{{ img.srcset }}" sizes="100vw"{% endif %}
         alt="" aria-hidden="true"
         {%- if priority %} loading="eager" fetchpriority="high"{% else %} loading="lazy" decoding="async"{% endif %}>
  {% endif %}
  {% if overlay %}<div class="thallo-block-container__overlay"></div>{% endif %}
  <div class="thallo-block-container__inner{{ style_classes('inner') }}"{{ style_attrs('inner') }}{{ slot_attrs('content') }}>{{ blocks(data.content) }}</div>
</{{ tag }}>
