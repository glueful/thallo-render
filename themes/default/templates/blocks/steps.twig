<section class="lemma-block lemma-block-steps lemma-block-steps--{{ data.orientation|default('horizontal') }}">
  <div class="lemma-block-steps__inner">
    {% if data.title %}<h2 class="lemma-block-steps__title">{{ data.title|editable_text('title') }}</h2>{% endif %}
    <div class="lemma-block-steps__items">{{ blocks(data.items) }}</div>
  </div>
</section>
