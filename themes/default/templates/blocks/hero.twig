{# hero — big heading, supporting copy, CTA buttons and media.
   Authored in the theme's BEM/computed-class convention (see navigation.twig,
   separator.twig): root class strings built in {% set %} maps up top, each
   enum guarded with ?? so an unknown stored value degrades to the default
   modifier instead of emitting a class no CSS matches.
   Fields: headline, title, description, links (nested button blocks), image
   (asset → media_image()), aside (nested blocks; takes the media slot instead of the
   image), orientation (vertical|horizontal), reverse, background
   (gradient|none|muted|inverted).
   Image discipline (storefront-performance spec §4): resolve FIRST, claim the
   at-most-one priority slot only on a non-null resolve, attributes from the claim. #}
{% set img = data.image ? media_image(data.image, [640, 960, 1280, 1920]) : null %}
{% set orientation = data.orientation|default('vertical') %}
{% set reverse = data.reverse|default(false) %}
{% set background = {gradient: 'gradient', none: 'none', muted: 'muted', inverted: 'inverted'}[data.background|default('gradient')] ?? 'gradient' %}
{% set aside = data.aside|default([]) %}
{% set rootClass = [
  'thallo-block thallo-block-hero',
  'thallo-block-hero--' ~ ({vertical: 'vertical', horizontal: 'horizontal'}[orientation] ?? 'vertical'),
  'thallo-block-hero--bg-' ~ background,
  reverse ? 'thallo-block-hero--reverse' : '',
]|join(' ')|trim %}
<header class="{{ rootClass }}{{ style_classes('root') }}"{{ style_attrs('root') }}>
  <div class="thallo-block-hero__inner">
    <div class="thallo-block-hero__wrapper">
      {% if data.headline %}<p class="thallo-block-hero__headline">{{ data.headline|editable_text('headline') }}</p>{% endif %}
      {% set headingLevel = data.heading_level|default('h1') %}
      {% if headingLevel == 'h2' %}<h2 class="thallo-block-hero__title{{ style_classes('title') }}"{{ style_attrs('title') }}>{{ data.title|editable_text('title') }}</h2>
      {% elseif headingLevel == 'h3' %}<h3 class="thallo-block-hero__title{{ style_classes('title') }}"{{ style_attrs('title') }}>{{ data.title|editable_text('title') }}</h3>
      {% else %}<h1 class="thallo-block-hero__title{{ style_classes('title') }}"{{ style_attrs('title') }}>{{ data.title|editable_text('title') }}</h1>
      {% endif %}
      {% if data.description %}<p class="thallo-block-hero__description">{{ data.description|editable_text('description') }}</p>{% endif %}
      {% if data.links|default([]) is not empty %}<div class="thallo-block-hero__links">{{ blocks(data.links) }}</div>{% endif %}
    </div>
    {% if aside is not empty %}
      <div class="thallo-block-hero__media thallo-block-hero__media--blocks{{ style_classes('media') }}"{{ style_attrs('media') }}>{{ blocks(aside) }}</div>
    {% elseif img %}
      {% set priority = claim_priority_image() %}
      <div class="thallo-block-hero__media{{ style_classes('media') }}"{{ style_attrs('media') }}>
        <img src="{{ img.src }}"
             {%- if img.srcset %} srcset="{{ img.srcset }}" sizes="(max-width: 48rem) 100vw, 40rem"{% endif %}
             alt=""
             {%- if priority %} loading="eager" fetchpriority="high"{% else %} loading="lazy" decoding="async"{% endif %}>
      </div>
    {% endif %}
  </div>
</header>
