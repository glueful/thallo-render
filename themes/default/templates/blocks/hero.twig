{% set img = data.image ? media(data.image) : null %}
{% set orientation = data.orientation|default('vertical') %}
<header class="lemma-block lemma-block-hero lemma-block-hero--{{ orientation }}{% if data.reverse|default(false) %} lemma-block-hero--reverse{% endif %}">
  <div class="lemma-block-hero__inner">
    <div class="lemma-block-hero__wrapper">
      {% if data.headline %}<p class="lemma-block-hero__headline">{{ data.headline|editable_text('headline') }}</p>{% endif %}
      <h1 class="lemma-block-hero__title">{{ data.title|editable_text('title') }}</h1>
      {% if data.description %}<p class="lemma-block-hero__description">{{ data.description|editable_text('description') }}</p>{% endif %}
      {% if data.links|default([]) is not empty %}<div class="lemma-block-hero__links">{{ blocks(data.links) }}</div>{% endif %}
    </div>
    {% if img %}<div class="lemma-block-hero__media"><img src="{{ img }}" alt=""></div>{% endif %}
  </div>
</header>
