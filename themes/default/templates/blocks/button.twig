{% set url = data.url|default('')|safe_url %}
<div class="thallo-block thallo-block-button thallo-block-button--{{ data.align|default('left') }}">
  {% if url %}<a class="thallo-block-button__link thallo-block-button__link--{{ data.variant|default('solid') }} thallo-block-button__link--{{ data.size|default('md') }}" href="{{ url }}">{{ data.label|editable_text('label') }}</a>
  {% else %}<span class="thallo-block-button__link thallo-block-button__link--{{ data.variant|default('solid') }} thallo-block-button__link--{{ data.size|default('md') }}">{{ data.label|editable_text('label') }}</span>{% endif %}
</div>
