{% set avatar = data.avatar ? media(data.avatar) : null %}
<figure class="thallo-block thallo-block-testimonial">
  <blockquote class="thallo-block-testimonial__quote">{{ data.quote|editable_text('quote') }}</blockquote>
  <figcaption class="thallo-block-testimonial__footer">
    {% if avatar %}<img class="thallo-block-testimonial__avatar" src="{{ avatar }}" alt="">{% endif %}
    <div class="thallo-block-testimonial__meta">
      {% if data.author %}<span class="thallo-block-testimonial__author">{{ data.author|editable_text('author') }}</span>{% endif %}
      {% if data.role %}<span class="thallo-block-testimonial__role">{{ data.role|editable_text('role') }}</span>{% endif %}
    </div>
  </figcaption>
</figure>
