{# feature — maps to refs.md `pageFeature`. A compact icon + title + description leaf block;
   drop several into a `grid`. Authored in the theme's BEM/hand-authored-CSS convention
   (see navigation.twig / separator.twig) — the matching rules live in assets/blocks.css.
   Fields (all optional): icon, title, description, url. #}
{% set url = data.url|default('')|safe_url %}
<div class="thallo-block thallo-block-feature">
  {% if data.icon %}<span class="thallo-block-feature__icon" aria-hidden="true">{{ icon(data.icon) ?? data.icon }}</span>{% endif %}
  {% if data.title %}<h3 class="thallo-block-feature__title">{% if url %}<a href="{{ url }}">{{ data.title|editable_text('title') }}</a>{% else %}{{ data.title|editable_text('title') }}{% endif %}</h3>{% endif %}
  {% if data.description %}<p class="thallo-block-feature__description">{{ data.description|editable_text('description') }}</p>{% endif %}
</div>
