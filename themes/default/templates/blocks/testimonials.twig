<section class="thallo-block thallo-block-testimonials thallo-block-testimonials--{{ data.layout|default('grid') }}">
  <div class="thallo-block-testimonials__inner">
    {% if data.title %}<h2 class="thallo-block-testimonials__title">{{ data.title|editable_text('title') }}</h2>{% endif %}
    <div class="thallo-block-testimonials__items">{{ blocks(data.items) }}</div>
  </div>
</section>
