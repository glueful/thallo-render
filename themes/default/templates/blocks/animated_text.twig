{# animated_text — reveal + finite word rotation (modern-blocks spec §3). Static floor:
   everything visible; JS (block-animated-text.js) adds --prepared/--in-view and rotates.
   Width reservation: ALL alternatives stacked in one grid cell; inactive ones
   visibility:hidden (CSS); the browser reserves the true max rendered width.
   Accessibility: `aria-label` is ignored by the paragraph role (and by several other
   roles), so a `tag: 'p'` instance silently lost the rotating word for assistive tech.
   Fixed uniformly across every tag: a visually-hidden span carries the stable phrase
   (prefix + first alternative + suffix) as the FIRST child — always in the
   accessibility tree regardless of the host element's role — while the entire visual
   assembly (prefix, rotate stack, suffix) is wrapped in exactly ONE aria-hidden
   container, so AT never doubles-up on the phrase. #}
{% set words = data.rotate_words|default('')|replace({"\r\n": "\n", "\r": "\n"})|split("\n") %}
{% set clean = [] %}
{% for w in words %}{% if w|trim != '' %}{% set clean = clean|merge([w|trim]) %}{% endif %}{% endfor %}
{% set tag = data.tag|default('h2') %}
{% set prefix = data.prefix|default('') %}
{% set suffix = data.suffix|default('') %}
{% set stable_parts = [] %}
{% if prefix != '' %}{% set stable_parts = stable_parts|merge([prefix]) %}{% endif %}
{% if clean is not empty %}{% set stable_parts = stable_parts|merge([clean|first]) %}{% endif %}
{% if suffix != '' %}{% set stable_parts = stable_parts|merge([suffix]) %}{% endif %}
{# Break tokens (2026-08 follow-up): authors may type <br>/<br/>/<br /> in
   prefix, suffix, or a rotate word; br_tokens turns ONLY those into real
   breaks after escaping. The stable SR phrase strips them to plain spaces —
   AT hears the phrase, never a token. #}
{% set stable_phrase = stable_parts|join(' ')|replace({'<br />': ' ', '<br/>': ' ', '<br>': ' '}) %}
{# Rotation interval in seconds (numeric_clamp: non-numeric -> null, else
   0.5–10); absent emits nothing and the runtime's 2.5s default applies. #}
{% set interval = data.interval|default(null)|numeric_clamp(0.5, 10) %}
{# Per-segment styling (2026-08 follow-up): each segment builds a class list
   (size/bold/italic) and a hex_color-guarded color — a non-hex value is
   dropped entirely, never emitted into the style attribute. #}
{% set p_cls = '' %}
{% if data.prefix_size|default('inherit') in ['sm', 'lg', 'xl'] %}{% set p_cls = p_cls ~ ' thallo-block-animated_text__seg--' ~ data.prefix_size %}{% endif %}
{% if data.prefix_bold|default(false) %}{% set p_cls = p_cls ~ ' thallo-block-animated_text__seg--bold' %}{% endif %}
{% if data.prefix_italic|default(false) %}{% set p_cls = p_cls ~ ' thallo-block-animated_text__seg--italic' %}{% endif %}
{% set p_color = data.prefix_color|default('')|hex_color %}
{% set r_cls = '' %}
{% if data.rotate_size|default('inherit') in ['sm', 'lg', 'xl'] %}{% set r_cls = r_cls ~ ' thallo-block-animated_text__seg--' ~ data.rotate_size %}{% endif %}
{% if data.rotate_bold|default(false) %}{% set r_cls = r_cls ~ ' thallo-block-animated_text__seg--bold' %}{% endif %}
{% if data.rotate_italic|default(false) %}{% set r_cls = r_cls ~ ' thallo-block-animated_text__seg--italic' %}{% endif %}
{% set r_color = data.rotate_color|default('')|hex_color %}
{% set s_cls = '' %}
{% if data.suffix_size|default('inherit') in ['sm', 'lg', 'xl'] %}{% set s_cls = s_cls ~ ' thallo-block-animated_text__seg--' ~ data.suffix_size %}{% endif %}
{% if data.suffix_bold|default(false) %}{% set s_cls = s_cls ~ ' thallo-block-animated_text__seg--bold' %}{% endif %}
{% if data.suffix_italic|default(false) %}{% set s_cls = s_cls ~ ' thallo-block-animated_text__seg--italic' %}{% endif %}
{% set s_color = data.suffix_color|default('')|hex_color %}
{% set inner %}
  {%- if prefix != '' %}<span class="thallo-block-animated_text__prefix{{ p_cls }}"{% if p_color != '' %} style="color: {{ p_color }}"{% endif %}>{{ prefix|br_tokens|editable_text('prefix') }}</span>{% endif -%}
  {%- if prefix != '' and clean is not empty %}{{ ' ' }}{% endif -%}
  {%- if clean is not empty %}
  <span class="thallo-block-animated_text__rotate{{ r_cls }}"{% if r_color != '' %} style="color: {{ r_color }}"{% endif %}>
    {%- for w in clean %}
    <span class="thallo-block-animated_text__word{% if loop.first %} thallo-block-animated_text__word--active{% endif %}">{{ w|br_tokens }}</span>
    {%- endfor %}
  </span>
  {%- endif %}
  {%- if suffix != '' and (prefix != '' or clean is not empty) %}{{ ' ' }}{% endif -%}
  {%- if suffix != '' %}<span class="thallo-block-animated_text__suffix{{ s_cls }}"{% if s_color != '' %} style="color: {{ s_color }}"{% endif %}>{{ suffix|br_tokens|editable_text('suffix') }}</span>{% endif -%}
{% endset %}
{% if tag == 'h1' %}<h1 class="thallo-block thallo-block-animated_text thallo-block-animated_text--{{ data.effect|default('fade') }}" data-effect="{{ data.effect|default('fade') }}" data-loop="{{ data.loop|default(false) ? '1' : '0' }}"{% if interval is not same as(null) %} data-interval="{{ interval }}"{% endif %}><span class="thallo-block-animated_text__sr">{{ stable_phrase }}</span><span aria-hidden="true">{{ inner }}</span></h1>
{% elseif tag == 'h3' %}<h3 class="thallo-block thallo-block-animated_text thallo-block-animated_text--{{ data.effect|default('fade') }}" data-effect="{{ data.effect|default('fade') }}" data-loop="{{ data.loop|default(false) ? '1' : '0' }}"{% if interval is not same as(null) %} data-interval="{{ interval }}"{% endif %}><span class="thallo-block-animated_text__sr">{{ stable_phrase }}</span><span aria-hidden="true">{{ inner }}</span></h3>
{% elseif tag == 'p' %}<p class="thallo-block thallo-block-animated_text thallo-block-animated_text--{{ data.effect|default('fade') }}" data-effect="{{ data.effect|default('fade') }}" data-loop="{{ data.loop|default(false) ? '1' : '0' }}"{% if interval is not same as(null) %} data-interval="{{ interval }}"{% endif %}><span class="thallo-block-animated_text__sr">{{ stable_phrase }}</span><span aria-hidden="true">{{ inner }}</span></p>
{% else %}<h2 class="thallo-block thallo-block-animated_text thallo-block-animated_text--{{ data.effect|default('fade') }}" data-effect="{{ data.effect|default('fade') }}" data-loop="{{ data.loop|default(false) ? '1' : '0' }}"{% if interval is not same as(null) %} data-interval="{{ interval }}"{% endif %}><span class="thallo-block-animated_text__sr">{{ stable_phrase }}</span><span aria-hidden="true">{{ inner }}</span></h2>
{% endif %}
{{ block_script('animated-text') }}
