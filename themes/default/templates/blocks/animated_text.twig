{# animated_text — reveal + finite word rotation (modern-blocks spec §3). Static floor:
   everything visible; JS (block-animated-text.js) adds --prepared/--in-view and rotates.
   Width reservation: ALL alternatives stacked in one grid cell; inactive ones
   visibility:hidden (CSS); the browser reserves the true max rendered width.
   Accessibility: `aria-label` is ignored by the paragraph role (and by several other
   roles), so a `tag: 'p'` instance silently lost the rotating word for assistive tech.
   Fixed uniformly across every tag: a visually-hidden span carries the stable phrase
   (prefix + first alternative + suffix) as the FIRST child — always in the
   accessibility tree regardless of the host element's role — while the entire visual
   assembly (prefix, rotate stack, suffix) is wrapped in exactly ONE aria-hidden
   container, so AT never doubles-up on the phrase. #}
{% set words = data.rotate_words|default('')|replace({"\r\n": "\n", "\r": "\n"})|split("\n") %}
{% set clean = [] %}
{% for w in words %}{% if w|trim != '' %}{% set clean = clean|merge([w|trim]) %}{% endif %}{% endfor %}
{% set tag = data.tag|default('h2') %}
{% set prefix = data.prefix|default('') %}
{% set suffix = data.suffix|default('') %}
{% set stable_parts = [] %}
{% if prefix != '' %}{% set stable_parts = stable_parts|merge([prefix]) %}{% endif %}
{% if clean is not empty %}{% set stable_parts = stable_parts|merge([clean|first]) %}{% endif %}
{% if suffix != '' %}{% set stable_parts = stable_parts|merge([suffix]) %}{% endif %}
{% set stable_phrase = stable_parts|join(' ') %}
{% set inner %}
  {%- if prefix != '' %}{{ prefix|editable_text('prefix') }}{% endif -%}
  {%- if prefix != '' and clean is not empty %}{{ ' ' }}{% endif -%}
  {%- if clean is not empty %}
  <span class="thallo-block-animated_text__rotate">
    {%- for w in clean %}
    <span class="thallo-block-animated_text__word{% if loop.first %} thallo-block-animated_text__word--active{% endif %}">{{ w }}</span>
    {%- endfor %}
  </span>
  {%- endif %}
  {%- if suffix != '' and (prefix != '' or clean is not empty) %}{{ ' ' }}{% endif -%}
  {%- if suffix != '' %}{{ suffix|editable_text('suffix') }}{% endif -%}
{% endset %}
{% if tag == 'h1' %}<h1 class="thallo-block thallo-block-animated_text thallo-block-animated_text--{{ data.effect|default('fade') }}" data-effect="{{ data.effect|default('fade') }}"><span class="thallo-block-animated_text__sr">{{ stable_phrase }}</span><span aria-hidden="true">{{ inner }}</span></h1>
{% elseif tag == 'h3' %}<h3 class="thallo-block thallo-block-animated_text thallo-block-animated_text--{{ data.effect|default('fade') }}" data-effect="{{ data.effect|default('fade') }}"><span class="thallo-block-animated_text__sr">{{ stable_phrase }}</span><span aria-hidden="true">{{ inner }}</span></h3>
{% elseif tag == 'p' %}<p class="thallo-block thallo-block-animated_text thallo-block-animated_text--{{ data.effect|default('fade') }}" data-effect="{{ data.effect|default('fade') }}"><span class="thallo-block-animated_text__sr">{{ stable_phrase }}</span><span aria-hidden="true">{{ inner }}</span></p>
{% else %}<h2 class="thallo-block thallo-block-animated_text thallo-block-animated_text--{{ data.effect|default('fade') }}" data-effect="{{ data.effect|default('fade') }}"><span class="thallo-block-animated_text__sr">{{ stable_phrase }}</span><span aria-hidden="true">{{ inner }}</span></h2>
{% endif %}
{{ block_script('animated-text') }}
