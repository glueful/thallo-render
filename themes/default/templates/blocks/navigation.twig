{% set items = menu(data.menu|default('')) %}
{% set reveal = data.submenu_trigger|default('hover') %}
{% set subicon = data.submenu_icon|default('chevron-down') %}
<div class="thallo-block thallo-block-navigation thallo-block-navigation--{{ data.orientation|default('horizontal') }} thallo-block-navigation--align-{{ data.align|default('start') }} thallo-block-navigation--size-{{ data.size|default('md') }} thallo-block-navigation--active-{{ data.active_style|default('underline') }} thallo-block-navigation--hover-{{ data.hover_style|default('color') }} thallo-block-navigation--reveal-{{ reveal }}">
  {% if items %}
    <nav class="thallo-block-navigation__nav">
      <ul class="thallo-block-navigation__list">
        {% for item in items %}
          {# One submenu level (nav-v2 spec §4): grandchildren FLATTEN into the dropdown. #}
          {% set kids = [] %}
          {% for c in item.children|default([]) %}
            {% set kids = kids|merge([c]) %}
            {% for g in c.children|default([]) %}{% set kids = kids|merge([g]) %}{% endfor %}
          {% endfor %}
          {# Item urls are ABSOLUTE (resolver output); current_path is host-relative.
             Derive the path side once — scheme+host split off, root-safe. #}
          {% set itemPath = '/' ~ (item.url|default('')|split('://')|last|split('/', 2)|last) %}
          {% set active = current_path is defined and itemPath == current_path %}
          {% if kids is empty %}
            <li class="thallo-block-navigation__item{% if active %} thallo-block-navigation__item--active{% endif %}">
              <a href="{{ item.url }}">{% if item.icon|default('') %}{{ icon(item.icon) }}{% endif %}{{ item.label }}</a>
            </li>
          {% elseif reveal == 'click' %}
            {# details-name exclusivity is progressive enhancement (spec P2):
               unsupported browsers may keep several open — acceptable v1. #}
            <li class="thallo-block-navigation__item thallo-block-navigation__item--parent{% if active %} thallo-block-navigation__item--active{% endif %}">
              <details class="thallo-block-navigation__details" name="nav-{{ block.id }}">
                <summary>{% if item.icon|default('') %}{{ icon(item.icon) }}{% endif %}{{ item.label }}{% if subicon != 'none' %}{{ icon(subicon) }}{% endif %}</summary>
                <ul class="thallo-block-navigation__submenu">
                  {% if item.url|default('') %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endif %}
                  {% for kid in kids %}
                    {% set kidPath = '/' ~ (kid.url|default('')|split('://')|last|split('/', 2)|last) %}
                    <li{% if current_path is defined and kidPath == current_path %} class="thallo-block-navigation__item--active"{% endif %}>
                      <a href="{{ kid.url }}">{% if kid.icon|default('') %}{{ icon(kid.icon) }}{% endif %}{{ kid.label }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </details>
            </li>
          {% else %}
            <li class="thallo-block-navigation__item thallo-block-navigation__item--parent{% if active %} thallo-block-navigation__item--active{% endif %}">
              {% if item.url|default('') %}<a href="{{ item.url }}">{% if item.icon|default('') %}{{ icon(item.icon) }}{% endif %}{{ item.label }}{% if subicon != 'none' %}{{ icon(subicon) }}{% endif %}</a>{% else %}<span tabindex="0">{% if item.icon|default('') %}{{ icon(item.icon) }}{% endif %}{{ item.label }}{% if subicon != 'none' %}{{ icon(subicon) }}{% endif %}</span>{% endif %}
              <ul class="thallo-block-navigation__submenu">
                {% for kid in kids %}
                  {% set kidPath = '/' ~ (kid.url|default('')|split('://')|last|split('/', 2)|last) %}
                    <li{% if current_path is defined and kidPath == current_path %} class="thallo-block-navigation__item--active"{% endif %}>
                    <a href="{{ kid.url }}">{% if kid.icon|default('') %}{{ icon(kid.icon) }}{% endif %}{{ kid.label }}</a>
                  </li>
                {% endfor %}
              </ul>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
</div>
