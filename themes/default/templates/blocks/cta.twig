{% set orientation = data.orientation|default('vertical') %}
<aside class="lemma-block lemma-block-cta lemma-block-cta--{{ data.variant|default('outline') }} lemma-block-cta--{{ orientation }}{% if data.reverse|default(false) %} lemma-block-cta--reverse{% endif %}">
  <div class="lemma-block-cta__inner">
    <div class="lemma-block-cta__wrapper">
      <h2 class="lemma-block-cta__title">{{ data.title|editable_text('title') }}</h2>
      {% if data.description %}<p class="lemma-block-cta__description">{{ data.description|editable_text('description') }}</p>{% endif %}
      {% if data.links|default([]) is not empty %}<div class="lemma-block-cta__links">{{ blocks(data.links) }}</div>{% endif %}
    </div>
  </div>
</aside>
