{# cta — contained call-to-action band (PageCTA anatomy). Authored in the theme's
   BEM/computed-class convention (see navigation.twig / separator.twig): class
   strings built in {% set %} maps up top, each guarded with ?? so an unknown
   stored enum degrades to the default modifier instead of emitting a class no
   CSS matches. Fields (seed order): title, description, variant, orientation,
   reverse, links (child button blocks). #}
{% set variant = data.variant|default('outline') %}
{% set orientation = data.orientation|default('vertical') %}
{% set reverse = data.reverse|default(false) %}
{% set rootClass = [
  'thallo-block thallo-block-cta',
  'thallo-block-cta--' ~ ({solid: 'solid', outline: 'outline', soft: 'soft', subtle: 'subtle', naked: 'naked'}[variant] ?? 'outline'),
  'thallo-block-cta--' ~ ({vertical: 'vertical', horizontal: 'horizontal'}[orientation] ?? 'vertical'),
  reverse ? 'thallo-block-cta--reverse' : '',
]|join(' ')|trim %}
<aside class="{{ rootClass }}{{ style_classes('root') }}"{{ style_attrs('root') }}>
  <div class="thallo-block-cta__inner{{ style_classes('panel') }}"{{ style_attrs('panel') }}>
    <div class="thallo-block-cta__wrapper">
      <h2 class="thallo-block-cta__title{{ style_classes('title') }}"{{ style_attrs('title') }}>{{ data.title|editable_text('title') }}</h2>
      {% if data.description %}<p class="thallo-block-cta__description">{{ data.description|editable_text('description') }}</p>{% endif %}
    </div>
    {% if data.links|default([]) is not empty or is_canvas() %}<div class="thallo-block-cta__links"{{ slot_attrs('links') }}>{{ blocks(data.links|default([])) }}</div>{% endif %}
  </div>
</aside>
