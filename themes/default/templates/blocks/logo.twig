{% set logo = site_logo() %}
{% set logoDark = site_logo('dark') %}
{# Positional loading (storefront-performance spec §4): header chrome loads eagerly,
   body/footer placements lazy — brand imagery NEVER claims fetchpriority. #}
{% set logoLoading = region_slug|default(null) == 'header' ? 'eager' : 'lazy' %}
{% set inner %}{% if logo and logoDark %}<img class="thallo-block-logo__image thallo-block-logo__image--light" src="{{ logo }}" alt="{{ site.name|default('') }}" loading="{{ logoLoading }}"{% if logoLoading == 'lazy' %} decoding="async"{% endif %}><img class="thallo-block-logo__image thallo-block-logo__image--dark" src="{{ logoDark }}" alt="{{ site.name|default('') }}" loading="{{ logoLoading }}"{% if logoLoading == 'lazy' %} decoding="async"{% endif %}>{% elseif logo %}<img class="thallo-block-logo__image" src="{{ logo }}" alt="{{ site.name|default('') }}" loading="{{ logoLoading }}"{% if logoLoading == 'lazy' %} decoding="async"{% endif %}>{% else %}<span class="thallo-block-logo__name">{{ site.name|default('') }}</span>{% endif %}{% endset %}
<div class="thallo-block thallo-block-logo thallo-block-logo--{{ data.size|default('medium') }}{% if logo and logoDark %} thallo-block-logo--has-dark{% endif %}">
  {% if data.link_home is not defined or data.link_home %}<a class="thallo-block-logo__link" href="/">{{ inner }}</a>{% else %}{{ inner }}{% endif %}
</div>
