<section class="lemma-block lemma-block-faq">
  <div class="lemma-block-faq__inner">
    {% if data.title %}<h2 class="lemma-block-faq__title">{{ data.title|editable_text('title') }}</h2>{% endif %}
    <div class="lemma-block-faq__items">
      {# Items rendered inline: <details name> needs the PARENT faq's group id
         for native exclusive-open — a child template can't know it. #}
      {% for item in data.items|default([]) %}
      <details class="lemma-block-faq__item"{% if not data.multiple|default(false) %} name="faq-{{ block.id }}"{% endif %}>
        <summary class="lemma-block-faq__question">{{ item.data.question|default('') }}</summary>
        <div class="lemma-block-faq__answer">{{ item.data.answer|default('')|safe_html }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
