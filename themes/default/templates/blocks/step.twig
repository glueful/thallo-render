<div class="thallo-block thallo-block-step">
  <span class="thallo-block-step__badge" aria-hidden="true"></span>
  <div class="thallo-block-step__body">
    <h3 class="thallo-block-step__title">{{ data.title|editable_text('title') }}</h3>
    {% if data.description %}<p class="thallo-block-step__description">{{ data.description|editable_text('description') }}</p>{% endif %}
  </div>
</div>
