{% set src = data.audio ? media(data.audio) : null %}
<figure class="thallo-block thallo-block-audio">
  {% if data.title %}<figcaption class="thallo-block-audio__title">{{ data.title|editable_text('title') }}</figcaption>{% endif %}
  {% if src %}<audio class="thallo-block-audio__player" src="{{ src }}" controls preload="metadata"></audio>{% endif %}
</figure>
