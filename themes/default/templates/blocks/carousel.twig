<div class="lemma-block lemma-block-carousel lemma-block-carousel--per-{{ data.slides_per_view|default('1') }}" data-arrows="{{ data.arrows|default(false) ? '1' : '0' }}" data-dots="{{ data.dots|default(false) ? '1' : '0' }}" data-autoplay="{{ data.autoplay|default(false) ? '1' : '0' }}">
  <div class="lemma-block-carousel__viewport">
    <div class="lemma-block-carousel__track">{{ blocks(data.slides) }}</div>
  </div>
</div>
