{# footer_columns — maps to refs.md `footerColumns`. A responsive grid of titled
   link lists. Authored in the theme's BEM/token convention (see navigation.twig,
   separator.twig): plain markup, styling carried by computed BEM classes.
   Fields: columns — a plain array of { label, items: [ { label, url } ] }
   (NOT child blocks; iterate the arrays directly). #}
<div class="thallo-block thallo-block-footer_columns">
  {% for col in data.columns|default([]) %}
    <div class="thallo-block-footer_columns__col">
      {% if col.label|default('') %}
        <h3 class="thallo-block-footer_columns__col-title">{{ col.label }}</h3>
      {% endif %}
      {% if col.items|default([]) is not empty %}
        <ul class="thallo-block-footer_columns__list">
          {% for item in col.items %}
            <li class="thallo-block-footer_columns__item">
              <a class="thallo-block-footer_columns__link" href="{{ item.url|default('')|safe_url }}">{{ item.label }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</div>
