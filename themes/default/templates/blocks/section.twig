{# section — a titled content band wrapping a child block list (maps to refs.md `pageSection`).
   Authored in the theme's BEM/computed-class convention (see navigation.twig / separator.twig):
   class strings built in {% set %} maps up top, each guarded with ?? so an unknown stored enum
   degrades to the default modifier instead of emitting a class no CSS matches.
   Fields (all optional): headline, title, description,
     headline_align / title_align / description_align (start|center|end; unset keeps the
     orientation's default), background (none|muted|subtle|inverted),
     orientation (vertical|horizontal), reverse (boolean), links (child button blocks),
     content (child blocks). #}
{% set background = data.background|default('none') %}
{% set orientation = data.orientation|default('vertical') %}
{% set reverse = data.reverse|default(false) %}
{% set alignMods = {start: 'start', center: 'center', end: 'end'} %}
{% set headlineAlign = alignMods[data.headline_align|default('')] ?? null %}
{% set titleAlign = alignMods[data.title_align|default('')] ?? null %}
{% set descriptionAlign = alignMods[data.description_align|default('')] ?? null %}
{% set hasHeader = (data.headline|default('')) is not empty
  or (data.title|default('')) is not empty
  or (data.description|default('')) is not empty %}
{% set rootClass = [
  'thallo-block thallo-block-section',
  'thallo-block-section--' ~ ({none: 'none', muted: 'muted', subtle: 'subtle', inverted: 'inverted'}[background] ?? 'none'),
  'thallo-block-section--' ~ ({vertical: 'vertical', horizontal: 'horizontal'}[orientation] ?? 'vertical'),
  reverse ? 'thallo-block-section--reverse' : '',
]|join(' ')|trim %}
<section class="{{ rootClass }}{{ style_classes('root') }}"{{ style_attrs('root') }}>
  <div class="thallo-block-section__inner">
    {% if hasHeader %}
    <div class="thallo-block-section__header">
      {% if data.headline|default('') %}<p class="thallo-block-section__headline{% if headlineAlign %} thallo-block-section__headline--{{ headlineAlign }}{% endif %}">{{ data.headline|editable_text('headline') }}</p>{% endif %}
      {% if data.title|default('') %}<h2 class="thallo-block-section__title{% if titleAlign %} thallo-block-section__title--{{ titleAlign }}{% endif %}">{{ data.title|editable_text('title') }}</h2>{% endif %}
      {% if data.description|default('') %}<p class="thallo-block-section__description{% if descriptionAlign %} thallo-block-section__description--{{ descriptionAlign }}{% endif %}">{{ data.description|editable_text('description') }}</p>{% endif %}
    </div>
    {% endif %}
    {% if data.content|default([]) is not empty or is_canvas() %}<div class="thallo-block-section__content"{{ slot_attrs('content') }}>{{ blocks(data.content|default([])) }}</div>{% endif %}
    {% if data.links|default([]) is not empty or is_canvas() %}<div class="thallo-block-section__links"{{ slot_attrs('links') }}>{{ blocks(data.links|default([])) }}</div>{% endif %}
  </div>
</section>
