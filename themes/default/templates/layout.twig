<!DOCTYPE html>
<html lang="{{ site.locale }}"{% if color_mode_enabled() %} data-color-mode-enabled="true"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# color-mode spec §3.1: no-flash resolver, verbatim from ColorMode::RESOLVER_JS,
     BEFORE any CSS so data-theme is set pre-paint. Emitted only when enabled. #}
  {{ color_mode_script() }}
  <title>{% block title %}{{ site.name }}{% endblock %}</title>
  {# Site-identity spec §3: the link renders only when the blob is anonymously
     servable (site_favicon() applies the media() predicate) — a missing icon
     beats one that 401s on the browser's anonymous fetch. #}
  {% set favicon = site_favicon() %}
  {% if favicon %}<link rel="icon" href="{{ favicon }}">{% endif %}
  <link rel="stylesheet" href="{{ asset('site.css') }}">
  <link rel="stylesheet" href="{{ asset('blocks.css') }}">
  <link rel="stylesheet" href="{{ asset('navigation.css') }}">
  <link rel="stylesheet" href="{{ asset('stepper.css') }}">
  {# Theme color config (theme-color-config spec §5): a :root + dark token
     override generated from the operator's accent/neutral choice. Emits nothing
     for the default (blue/slate). AFTER the theme CSS, BEFORE custom.css so
     custom CSS stays the final escape hatch. #}
  {{ theme_colors_style() }}
  {# Site custom CSS (custom-css spec §4): DB-backed, loaded LAST so operator
     rules win the cascade; null (absent/empty) emits nothing. #}
  {% set customCss = custom_css() %}
  {% if customCss %}<link rel="stylesheet" href="{{ customCss }}">{% endif %}
  {# Package theme runtime (theme-runtime spec §2): behavior is package-owned and
     fingerprinted — themes ship presentation (CSS) only. Loaded ONCE here; canvas-aware
     (modules no-op in the canvas stage). #}
  <script defer src="{{ runtime_script() }}"></script>
</head>
<body>
  {# Skip link (theme-runtime spec §7): FIRST focusable element in the body —
     keyboard users bypass the chrome straight to the main landmark. #}
  <a class="skip-link" href="#main">Skip to content</a>
  {% if preview|default(false) %}
    {# Above the sticky header on purpose: blur/stickiness must never hide it. #}
    {% set bar = preview_bar|default(null) %}
    <div class="preview-banner">
      <span class="preview-banner__status">
        {%- if bar and bar.status == 'published' -%}
          <span class="preview-banner__dot preview-banner__dot--live"></span>
          Published — previewing the latest draft
        {%- elseif bar and bar.status == 'routeless' -%}
          <span class="preview-banner__dot preview-banner__dot--warn"></span>
          Published without a route — previewing the latest draft
        {%- elseif bar and bar.status == 'unpublished' -%}
          <span class="preview-banner__dot preview-banner__dot--draft"></span>
          Draft — not published yet
        {%- else -%}
          Preview — showing the latest draft
        {%- endif -%}
      </span>
      <span class="preview-banner__actions">
        {% if bar and bar.editor_url %}
        <a class="preview-banner__action" href="{{ bar.editor_url }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
          Edit
        </a>
        {% endif %}
        {% if bar and bar.design_url %}
        <a class="preview-banner__action" href="{{ bar.design_url }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          Design
        </a>
        {% endif %}
        {% if bar and bar.status == 'published' and bar.live_path %}
        <a class="preview-banner__action" href="{{ bar.live_path }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          View live
        </a>
        {% endif %}
        <a class="preview-banner__action" href="/_preview/exit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          Exit preview
        </a>
      </span>
    </div>
  {% endif %}
  {# Global chrome regions (global-regions spec): a saved region renders through
     region_blocks() (annotation-suppressed internally); EVERY null — unbound
     reader, absent row, saved-empty list — falls back to the hardcoded chrome
     below. Hiding is a page _presentation decision, never an empty region. #}
  {% set headerHidden = (presentation.header|default('default')) == 'hidden' %}
  {% set headerHtml = headerHidden ? null : region_blocks('header') %}
  {% if headerHtml %}
    {% set hs = region_settings('header') %}
    {# Presentation → classes, computed up top (logos.twig authoring shape) so the
       markup stays clean. Same class names the CSS + tests already expect — only
       the shape changes: width picks one modifier, sticky adds one when set. #}
    {% set headerClass = [
      'site-header thallo-region thallo-region-header',
      {contained: 'thallo-region-header--contained', full: 'thallo-region-header--full'}[hs.width|default('contained')] ?? 'thallo-region-header--contained',
      hs.sticky|default(false) ? 'thallo-region-header--sticky' : ''
    ]|join(' ')|trim %}
    <header class="{{ headerClass }}">
      <div class="site-header__inner">{{ headerHtml }}</div>
    </header>
  {% elseif not headerHidden %}
  <header class="site-header">
    <div class="site-header__inner">
      {% set logo = site_logo() %}
      {% set logoDark = site_logo('dark') %}
      {# --has-dark modifier (site-identity spec §3): the template — not a CSS
         sibling probe — decides when the dark swap applies, so light-only
         markup stays byte-identical. #}
      <a href="/" class="site-name{% if logo and logoDark %} site-name--has-dark{% endif %}">
        {%- if logo and logoDark -%}
          <img class="site-logo site-logo--light" src="{{ logo }}" alt="{{ site.name }}">
          <img class="site-logo site-logo--dark" src="{{ logoDark }}" alt="{{ site.name }}">
        {%- elseif logo -%}
          <img class="site-logo" src="{{ logo }}" alt="{{ site.name }}">
        {%- else -%}
          {{ site.name }}
        {%- endif -%}
      </a>
      {# Fallback nav (theme-runtime spec §7): a labelled landmark wrapped in
         the SAME details disclosure pattern the navigation block uses, so the
         runtime's navigation module and the 48rem mobile CSS govern both. #}
      <nav class="site-nav" aria-label="Main navigation">
        <details class="site-nav__mobile thallo-block-navigation__mobile" data-thallo-enhance="navigation">
          <summary class="thallo-block-navigation__hamburger"><span class="thallo-block-navigation__hamburger-icon" aria-hidden="true"></span><span class="thallo-block-navigation__hamburger-label">Menu</span></summary>
          <ul class="site-nav__list">
            {% for item in menu('main') %}
              {% set p = '/' ~ (item.url|default('')|split('://')|last|split('/', 2)|last) %}
              <li><a href="{{ item.url }}"{% if current_path is defined and p == current_path %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </details>
      </nav>
    </div>
  </header>
  {% endif %}
  {# The COMPOSED presentation context (spec §5a): page _presentation override
     -> theme.json per-type -> theme.json default -> built-ins. Templates never
     read _presentation directly. #}
  {% set layoutClass = {centered: 'layout--centered', full: 'layout--full'}[presentation.layout ?? 'centered'] ?? 'layout--centered' %}
  <main id="main" tabindex="-1" class="{{ layoutClass }}">
    {% block content %}{% endblock %}
  </main>
  {% set footerHidden = (presentation.footer|default('default')) == 'hidden' %}
  {% set footerHtml = footerHidden ? null : region_blocks('footer') %}
  {% if footerHtml %}
    {% set fs = region_settings('footer') %}
    <footer class="site-footer thallo-region thallo-region-footer thallo-region-footer--{{ fs.width|default('contained') }}">
      <div class="site-footer__inner">{{ footerHtml }}</div>
    </footer>
  {% elseif not footerHidden %}
  <footer class="site-footer">
    <div class="site-footer__inner"><small>{{ site.name }}</small></div>
  </footer>
  {% endif %}
</body>
</html>
