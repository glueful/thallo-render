{% extends 'layout.twig' %}
{% block title %}Not found — {{ site.name }}{% endblock %}
{% block content %}
<section class="error-page">
  <p class="error-page__code">404</p>
  <h1 class="error-page__title">Page not found</h1>
  <p class="error-page__lead">Sorry, we couldn’t find the page you’re looking for.</p>
  <div class="error-page__actions">
    <a class="error-page__btn error-page__btn--primary" href="/">Go back home</a>
  </div>
</section>
{% endblock %}
