{
  "name": "layout properties (container-layout spec \u00a73.2\u20133.3)",
  "cases": [
    {
      "name": "display: base flex inherits into md and lg",
      "property": "layout.display",
      "classes": [],
      "instance": {
        "layout": {
          "display": {
            "base": {
              "type": "choice",
              "value": "flex"
            }
          }
        }
      },
      "expect": {
        "base": {
          "value": {
            "type": "choice",
            "value": "flex"
          },
          "source": "instance",
          "state": "explicit"
        },
        "md": {
          "value": {
            "type": "choice",
            "value": "flex"
          },
          "source": "instance",
          "state": "inherited"
        },
        "lg": {
          "value": {
            "type": "choice",
            "value": "flex"
          },
          "source": "instance",
          "state": "inherited"
        }
      }
    },
    {
      "name": "display: grid at md overrides an inherited base flex",
      "property": "layout.display",
      "classes": [],
      "instance": {
        "layout": {
          "display": {
            "base": {
              "type": "choice",
              "value": "flex"
            },
            "md": {
              "type": "choice",
              "value": "grid"
            }
          }
        }
      },
      "expect": {
        "base": {
          "value": {
            "type": "choice",
            "value": "flex"
          },
          "source": "instance",
          "state": "explicit"
        },
        "md": {
          "value": {
            "type": "choice",
            "value": "grid"
          },
          "source": "instance",
          "state": "explicit"
        },
        "lg": {
          "value": {
            "type": "choice",
            "value": "grid"
          },
          "source": "instance",
          "state": "inherited"
        }
      }
    },
    {
      "name": "display: a reset at md terminates the base value and lg inherits the reset",
      "property": "layout.display",
      "classes": [],
      "instance": {
        "layout": {
          "display": {
            "base": {
              "type": "choice",
              "value": "flex"
            },
            "md": {
              "type": "reset"
            }
          }
        }
      },
      "expect": {
        "base": {
          "value": {
            "type": "choice",
            "value": "flex"
          },
          "source": "instance",
          "state": "explicit"
        },
        "md": {
          "value": null,
          "source": "instance",
          "state": "reset"
        },
        "lg": {
          "value": null,
          "source": "instance",
          "state": "reset"
        }
      }
    },
    {
      "name": "columns: a class supplies lg, the instance owns base",
      "property": "layout.columns",
      "classes": [
        {
          "id": "c1",
          "style": {
            "layout": {
              "columns": {
                "lg": {
                  "type": "choice",
                  "value": "1-2"
                }
              }
            }
          }
        }
      ],
      "instance": {
        "layout": {
          "columns": {
            "base": {
              "type": "choice",
              "value": "1"
            }
          }
        }
      },
      "expect": {
        "base": {
          "value": {
            "type": "choice",
            "value": "1"
          },
          "source": "instance",
          "state": "explicit"
        },
        "md": {
          "value": {
            "type": "choice",
            "value": "1"
          },
          "source": "instance",
          "state": "inherited"
        },
        "lg": {
          "value": {
            "type": "choice",
            "value": "1-2"
          },
          "source": "class:c1",
          "state": "explicit"
        }
      }
    },
    {
      "name": "gap: a token at md, nothing at base",
      "property": "layout.gap.column",
      "classes": [],
      "instance": {
        "layout": {
          "gap": {
            "column": {
              "md": {
                "type": "token",
                "value": "spacing.lg"
              }
            }
          }
        }
      },
      "expect": {
        "base": {
          "value": null,
          "source": "theme-default",
          "state": "theme-default"
        },
        "md": {
          "value": {
            "type": "token",
            "value": "spacing.lg"
          },
          "source": "instance",
          "state": "explicit"
        },
        "lg": {
          "value": {
            "type": "token",
            "value": "spacing.lg"
          },
          "source": "instance",
          "state": "inherited"
        }
      }
    },
    {
      "name": "overflow is not responsive: one value for every breakpoint",
      "property": "layout.overflow",
      "classes": [],
      "instance": {
        "layout": {
          "overflow": {
            "type": "choice",
            "value": "hidden"
          }
        }
      },
      "expect": {
        "base": {
          "value": {
            "type": "choice",
            "value": "hidden"
          },
          "source": "instance",
          "state": "explicit"
        }
      }
    },
    {
      "name": "span: a class value with no instance declaration",
      "property": "layout.span",
      "classes": [
        {
          "id": "c1",
          "style": {
            "layout": {
              "span": {
                "base": {
                  "type": "choice",
                  "value": "2"
                }
              }
            }
          }
        }
      ],
      "instance": {},
      "expect": {
        "base": {
          "value": {
            "type": "choice",
            "value": "2"
          },
          "source": "class:c1",
          "state": "explicit"
        },
        "md": {
          "value": {
            "type": "choice",
            "value": "2"
          },
          "source": "class:c1",
          "state": "inherited"
        },
        "lg": {
          "value": {
            "type": "choice",
            "value": "2"
          },
          "source": "class:c1",
          "state": "inherited"
        }
      }
    }
  ]
}
